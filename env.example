# Copy to .env.local and fill in your values. Never commit .env.local.

# Google OAuth (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Get refresh token once via /auth flow, then paste here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here
# Optional: access token and expiry (server auto-refreshes from refresh token)
# GOOGLE_ACCESS_TOKEN=
# GOOGLE_TOKEN_EXPIRY=

# Secret for hidden warmup URL: /api/cache-it-all?key=...
# CACHE_WARM_SECRET=pick-a-long-random-string

# Site URL (e.g. https://lotusfx.com or your Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:8004

# Analytics — set ONE approach (not both direct GA4 and GTM loading the same GA4 tag)
# Direct GA4 (gtag.js) — used when NEXT_PUBLIC_GTM_ID is not set
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container — when set, direct gtag.js is NOT loaded (avoid duplicates)
NEXT_PUBLIC_GTM_ID=
# Set to "true" when a consent banner is added; until then analytics loads in production only
# NEXT_PUBLIC_ANALYTICS_CONSENT_REQUIRED=true

# Exchange rate API (per country - get from your backend)
# EXCHANGE_RATE_API_URL_AU=
# EXCHANGE_RATE_X_KEY_AU=
# EXCHANGE_RATE_X_CLIENT_AU=
# (same for NZ, FJ)

# If backend SSL is invalid (dev only): ALLOW_INSECURE_SSL=true